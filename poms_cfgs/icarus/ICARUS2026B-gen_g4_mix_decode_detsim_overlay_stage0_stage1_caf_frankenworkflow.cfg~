[global]
group      = icarus
experiment = icarus
icaruspro  = icaruspro
wrapper    = file:///${FIFE_UTILS_DIR}/libexec/fife_wrap
version    = v10_06_00_1001
quals      = e26:prof

neventsperjob = -1

# Six fcl files will be run for full processing.
fclfile1 = override_me # <-- gen fcl or stage1
fclfile2 = override_me # <-- g4 or caf
fclfile3 = override_me # <-- mix
fclfile4 = override_me # <-- decode
fclfile5 = override_me # <-- detsim
fclfile6 = override_me # <-- overlay
fclfile7 = override_me # <-- stage0

fcl_list = override_me # A list of all the fcls we ran.

wrapper1 = wrapper1.fcl
wrapper2 = wrapper2.fcl
wrapper3 = wrapper3.fcl
wrapper4 = wrapper4.fcl
wrapper5 = wrapper5.fcl
wrapper6 = wrapper6.fcl
wrapper7 = wrapper7.fcl

productionlabel        = ICARUS2026B
mdprojectstage         = gen_g4_mix_decode_detsim_overlay_stage0
mdproductiontype       = official
productiontype         = mc
test_productiontype    = test_%(productiontype)s
mdproductionname       = %(productionlabel)s
test_mdproductionname  = test_%(productionlabel)s
sample                 = FakeData
mdfirststage           = override_me
mdlaststage            = override_me
fclname                = override_me
basename               = %(mdproductiontype)s
outputdataset          = %(productiontype)s_%(mdproductionname)s_%(version)s_%(fclname)s_%(sample)s
outputdatasetname      = %(outputdataset)s
base                   = /pnfs/sbn/data/sbn_fd/poms_production/
test_base              = /pnfs/sbn/scratch/users/icaruspro/poms_production/
basedir                = %(base)s/%(productiontype)s/%(productionlabel)s/%(version)s/%(fclname)s/%(sample)s/
outdir                 = %(basedir)s
project_name           = FakeDatasets

# Adding GENIE tune and tag used to run
genie_tune             = AR2520i00000
genie_tag              = v3_06_02_sbn3
genie_xsec_tag         = v3_06_02_sbn2
# And the nusystematics qualifier
nusystematics_tag      = v1_05_07
nusystematics_qual     = e26:sbn3:prof

# Declare base dataset -- we'll add stream name and software version in add_output
sam_dataset=override_me

[env_pass]
SAM_EXPERIMENT     = %(experiment)s
SAM_GROUP          = %(group)s
SAM_STATION        = %(experiment)s
XRD_CONNECTIONRETRY=32
XRD_REQUESTTIMEOUT =14400
XRD_REDIRECTLIMIT  =255
XRD_LOADBALANCERTTL=7200
XRD_STREAMTIMEOUT  =7200
IFDH_CP_MAXRETRIES = 3
IFDH_DEBUG         = 1
#IFDH_VERSION       =v2_6_1
#IFDH_BASE_URI=https://samweb.fnal.gov:8483/sam/${EXPERIMENT}/api

[prelaunch]
script = mkdir -p %(basedir)s

[submit]
group                      = %(group)s
subgroup                   = standard
role                       = production
resource-provides          = usage_model=OPPORTUNISTIC,DEDICATED,OFFSITE
expected-lifetime          = 2h
memory                     = 2000MB
N                          = -1
n_files_per_job            = 1 
append_condor_requirements = '(TARGET.HAS_CVMFS_icarus_opensciencegrid_org==true)&&(TARGET.HAS_SINGULARITY=?=true)'
lines_1                    = '+SingularityImage=\"/cvmfs/singularity.opensciencegrid.org/fermilab/fnal-wn-sl7:latest\"'
lines_2                    = '+FERMIHTC_AutoRelease=True'
lines_3                    = '+FERMIHTC_GraceMemory=6000'
lines_4                    = '+FERMIHTC_GraceLifetime=3600'

blacklist                  = SLATE_US_NMSU_DISCOVERY,RAL
cpu                        = 1

# set a safety to not overload the grid
maxConcurrent = 2000

# These are necessary files, we get from app.
# Should work to get these from sbnutil once the PR is merged...
# Edit: Copy these to ICARUS areas.
f_1 = dropbox:///exp/sbnd/app/users/sbndpro/mcp/SBND2026B_Ar25/srcs/sbnutil/scripts/sbnd/metadata_prescripts.sh
f_2 = dropbox:///exp/sbnd/app/users/sbndpro/mcp/SBND2026B_Ar25/srcs/sbnutil/scripts/sbnd/metadata_postscripts_MC_onestage.sh
f_3 = dropbox:///exp/sbnd/app/users/sbndpro/mcp/SBND2026B_Ar25/srcs/sbnutil/scripts/icarus/runMix.sh
f_4 = dropbox:///exp/sbnd/app/users/sbndpro/mcp/SBND2026B_Ar25/srcs/sbnutil/scripts/icarus/stashDataFile.sh
#f_5 = dropbox:///exp/sbnd/app/users/sbndpro/mcp/SBND2026B_Ar25/srcs/sbnutil/scripts/icarus/runLarThenDeleteInput.sh

[sam_consumer]
limit     = 1
schema    = root
appfamily = art
appname   = %(mdprojectstage)s
appvers   = %(version)s

# In [job_setup], we define the prescripts to be run.
# These will control necessary setups, as well as key variables for metadata.
# If in doubt reach out to John Plows on Slack.

[job_setup]
debug        = True
ifdh_art     = True
source       = /cvmfs/icarus.opensciencegrid.org/products/icarus/setup_icarus.sh
setup_0      = icaruscode %(version)s -q %(quals)s
setup_1	     = -t sbnutil

# To ensure we're declaring direct to SBN SAM.
prescript   = source /cvmfs/icarus.opensciencegrid.org/products/icarus/setup_icarus.sh && export PRODUCTS=/cvmfs/sbn.opensciencegrid.org/products/sbn:${PRODUCTS} && export SAM_EXPERIMENT=sbn

# Add CONDOR_DIR_INPUT to the FHICL_FILE_PATH and export the WORKDIR
prescript_1 = export FHICL_FILE_PATH=${CONDOR_DIR_INPUT}:${FHICL_FILE_PATH} && export WORKDIR=${PWD} && export FHICL_FILE_PATH=${WORKDIR}:${FHICL_FILE_PATH}

prescript_2 = export IFDH_OUTPUT_DIR=%(basedir)s && echo "IFDH_OUTPUT_DIR is ${IFDH_OUTPUT_DIR}"

# Frankenworkflow: We unsetup the usual UPS products and substitute the Ar25 ones
prescript_3 = unsetup genie && unsetup genie_xsec && unsetup lhapdf && unsetup pythia8 && unsetup hepmc3 && unsetup dk2nugenie && unsetup nugen && unsetup nusystematics
prescript_4 = setup nusystematics %(nusystematics_tag)s -q %(nusystematics_qual)s && setup genie_xsec %(genie_xsec_tag)s -q %(genie_tune)s:e1000:k250
prescript_5 = ups active

# Postscripts are run after all the executables are finished.
postscript = ls -ltrh

# For this workflow, there will be two stages.
# gen_g4_mix_decode_overlay_stage0: Generate the Ar25 files and mix them with raw minbias files. Keep going to stage0
# stage1_caf: Run high level reconstruction and CAFMaker. Needed because we want 

# First executable -- echo.
# This will print a warning if not set in the stage.

[executable]
name=echo
arg_1="YOU HAVE NOT SET THE EXECUTABLE 0. GO FIX THIS IN THE [stage] BLOCK. I WILL EXIT NOW."

[executable_1]
name=echo
arg_1="YOU HAVE NOT SET THE EXECUTABLE 1. GO FIX THIS IN THE [stage] BLOCK. I WILL EXIT NOW."

[executable_2]
name=echo
arg_1="YOU HAVE NOT SET THE EXECUTABLE 2. GO FIX THIS IN THE [stage] BLOCK. I WILL EXIT NOW."

[executable_3]
name=echo
arg_1="YOU HAVE NOT SET THE EXECUTABLE 3. GO FIX THIS IN THE [stage] BLOCK. I WILL EXIT NOW."

[executable_4]
name=echo
arg_1="YOU HAVE NOT SET THE EXECUTABLE 4. GO FIX THIS IN THE [stage] BLOCK. I WILL EXIT NOW."

[executable_5]
name=echo
arg_1="YOU HAVE NOT SET THE EXECUTABLE 5. GO FIX THIS IN THE [stage] BLOCK. I WILL EXIT NOW."

[executable_6]
name=echo
arg_1="YOU HAVE NOT SET THE EXECUTABLE 6. GO FIX THIS IN THE [stage] BLOCK. I WILL EXIT NOW."

[executable_7]
name=echo
arg_1="YOU HAVE NOT SET THE EXECUTABLE 7. GO FIX THIS IN THE [stage] BLOCK. I WILL EXIT NOW."


# I will also leave job_output empty here.
# You should set this in stage.
[job_output]
addoutput=
rename=
dest=%(basedir)s/%(basename)s
declare_metadata=True
metadata_extractor=json
add_location=True
hash=0
filter_metadata=rootout
filter_metadata_1=art.first_event
filter_metadata_2=art.last_event
add_to_dataset=_poms_task

# A unified stage for gen --> g4 --> mix --> decode --> overlay --> stage0.
# Using Prabhjot's scripts to stash the input data file, and to run the mix.
[stage_gen_g4_mix_decode_detsim_overlay_stage0]

# 0th exec grabs the input data file path (`--sam-web-uri=...' argument fife_wrap inserts)
# and pipes it to a text file that our next scripts will read from.
executable.name = sh
executable.arg_1 = \$CONDOR_DIR_INPUT/stashDataFile.sh

# 1st exec runs gen.
executable_1.name = lar
executable_1.arg_1 = -c
executable_1.arg_2 = wrapper1.fcl
executable_1.arg_3 = -o
executable_1.arg_4 = %(mdfirststage)s.root
executable_1.arg_5 = -T
executable_1.arg_6 = hist_%(mdfirststage)s.root
executable_1.arg_7 = -n
executable_1.arg_8 = %(nevt)s
executable_1.arg_9 = --sam-data-tier
executable_1.arg_10 = gen
executable_1.arg_11 = --sam-stream-name
executable_1.arg_12 = %(streamname)s

# 2nd exec runs g4 on the input event record.
# The output must always be `genfile.root.local'
executable_2.name  = lar
executable_2.arg_1 = -c
executable_2.arg_2 = wrapper2.fcl
executable_2.arg_3 = -o
executable_2.arg_4 = genfile.root.local
executable_2.arg_5 = -T
executable_2.arg_6 = hist_%(mdfirststage)s_g4.root
executable_2.arg_7 = -n
executable_2.arg_8 = -1
executable_2.arg_9 = --sam-data-tier
executable_2.arg_10 = simulated
executable_2.arg_11 = --sam-stream-name
executable_2.arg_12 = out1
executable_2.arg_13 = -s
executable_2.arg_14 = %(mdfirststage)s.root

# 3rd exec runs the mixing, using `runMix.sh`
# This is done so 0th exec gets cat`'ed out and passed in
executable_3.name  = sh
executable_3.arg_1 = \$CONDOR_DIR_INPUT/runMix.sh
executable_3.arg_2 = -c
executable_3.arg_3 = wrapper3.fcl
executable_3.arg_4 = -o
executable_3.arg_5 = %(mdfirststage)s_g4_mix.root
executable_3.arg_5 = -T
executable_3.arg_6 = hist_%(mdfirststage)s_g4_mix.root
executable_3.arg_7 = -n
executable_3.arg_8 = -1
executable_3.arg_9 = -b
executable_3.arg_10 = %(streamname)s

# 4th exec runs decode on the mixed file
executable_4.name  = lar
executable_4.arg_1 = -c
executable_4.arg_2 = wrapper4.fcl
executable_4.arg_3 = -o
executable_4.arg_4 = %(mdfirststage)s_g4_mix_decode.root
executable_4.arg_5 = -T
executable_4.arg_6 = hist_%(mdfirststage)s_g4_mix_decode.root
executable_4.arg_7 = -n
executable_4.arg_8 = -1
executable_4.arg_9 = --sam-data-tier
executable_4.arg_10 = decode
executable_4.arg_11 = --sam-stream-name
executable_4.arg_12 = out1
executable_4.arg_13 = -s
executable_4.arg_14 = %(mdfirststage)s_g4_mix.root

# 5th exec runs detsim on the decoded file
executable_5.name  = lar
executable_5.arg_1 = -c
executable_5.arg_2 = wrapper5.fcl
executable_5.arg_3 = -o
executable_5.arg_4 = %(mdfirststage)s_g4_mix_decode_detsim.root
executable_5.arg_5 = -T
executable_5.arg_6 = hist_%(mdfirststage)s_g4_mix_decode_detsim.root
executable_5.arg_7 = -n
executable_5.arg_8 = -1
executable_5.arg_9 = --sam-data-tier
executable_5.arg_10 = detector-simulated
executable_5.arg_11 = --sam-stream-name
executable_5.arg_12 = out1
executable_5.arg_13 = -s
executable_5.arg_14 = %(mdfirststage)s_g4_mix_decode.root

# 6th exec runs overlay on the detsim file
executable_6.name  = lar
executable_6.arg_1 = -c
executable_6.arg_2 = wrapper6.fcl
executable_6.arg_3 = -o
executable_6.arg_4 = %(mdfirststage)s_g4_mix_decode_detsim_overlay.root
executable_6.arg_5 = -T
executable_6.arg_6 = hist_%(mdfirststage)s_g4_mix_decode_detsim_overlay.root
executable_6.arg_7 = -n
executable_6.arg_8 = -1
executable_6.arg_9 = --sam-data-tier
executable_6.arg_10 = overlaid
executable_6.arg_11 = --sam-stream-name
executable_6.arg_12 = out1
executable_6.arg_13 = -s
executable_6.arg_14 = %(mdfirststage)s_g4_mix_decode_detsim.root

# 7th exec runs stage0 on the detsim file
executable_7.name  = lar
executable_7.arg_1 = -c
executable_7.arg_2 = wrapper7.fcl
executable_7.arg_3 = -o
executable_7.arg_4 = %(mdfirststage)s_g4_mix_decode_detsim_overlay_stage0.root
executable_7.arg_5 = -T
executable_7.arg_6 = hist_%(mdfirststage)s_g4_mix_decode_detsim_overlay_stage0.root
executable_7.arg_7 = -n
executable_7.arg_8 = -1
executable_7.arg_9 = --sam-data-tier
executable_7.arg_10 = stage0
executable_7.arg_11 = --sam-stream-name
executable_7.arg_12 = out1
executable_7.arg_13 = -s
executable_7.arg_14 = %(mdfirststage)s_g4_mix_decode_detsim_overlay.root

# A second stage for stage1 --> caf.
# This is because we setup a different icaruscode, with updated calibration DB.

[stage_stage1_caf]
# 0th exec runs stage1.
# This produces an artroot file to run cafmaker on, and two additional files:
# --> larcv file for SPINE
# --> calibration ntuple for.. calibration
# We keep both.
executable.name = lar
executable.arg_1 = -c
executable.arg_2 = wrapper1.fcl
executable.arg_3 = -o
executable.arg_4 = %(mdfirststage)s_g4_mix_decode_detsim_overlay_stage0_stage1.root
executable.arg_5 = -T
executable.arg_6 = hist_%(mdfirststage)s_g4_mix_decode_detsim_overlay_stage0_stage1.root
executable.arg_7 = -n
executable.arg_8 = %(nevt)s
executable.arg_9 = --sam-data-tier
executable.arg_10 = stage1
executable.arg_11 = --sam-stream-name
executable.arg_12 = out1
executable.arg_13 = -s
executable.arg_14 = %(mdfirststage)s_g4_mix_decode_detsim_overlay_stage0.root

# 1st executable runs cafmaker.
executable.name = lar
executable.arg_1 = -c
executable.arg_2 = wrapper1.fcl
executable.arg_3 = -n
executable.arg_4 = -1
executable.arg_5 = --sam-data-tier
executable.arg_6 = caf
executable.arg_7 = --sam-stream-name
executable.arg_8 = out1
executable.arg_9 = -s
executable.arg_10 = %(mdfirststage)s_g4_mix_decode_detsim_overlay_stage0_stage1.root